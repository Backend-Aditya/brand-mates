# Hostinger SMTP — from hPanel > Emails > your mailbox > Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@brandmates.au
SMTP_PASS=your-mailbox-password

# Where contact-form enquiries land
CONTACT_TO_EMAIL=info@brandmates.au
# Where newsletter signups land (defaults to CONTACT_TO_EMAIL if unset)
SUBSCRIBE_TO_EMAIL=info@brandmates.au
